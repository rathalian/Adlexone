includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - src/Http
        - src/Auth
        - src/Database
        - src/support
        - src/Screen/ItemScreen.php
        - src/Screen/SearchScreen.php
    excludePaths:
        - src/support/SharedMethods.php
    treatPhpDocTypesAsCertain: false
