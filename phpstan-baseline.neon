parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_array\(\) with array\<mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 3
			path: src/Application/RuleRunner.php

		-
			message: '#^Variable \$_POST on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 3
			path: src/Application/RuleRunner.php

		-
			message: '#^Strict comparison using \=\=\= between mixed and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Data/SavedSearch.php

		-
			message: '#^Empty array passed to foreach\.$#'
			identifier: foreach.emptyArray
			count: 1
			path: src/Html/Blocks.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: src/Html/Blocks.php

		-
			message: '#^Offset ''itemId'' does not exist on array\{name\: string, href\: string, meta\?\: string, metaTitle\?\: string, search\?\: string, cells\?\: array\<string, string\>, actions\?\: array\<int, array\{href\?\: string, label\: string, tone\?\: string, confirm\?\: string, target\?\: string, inline\?\: bool, disabled\?\: bool\}\>\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Html/Blocks.php

		-
			message: '#^Strict comparison using \!\=\= between array\{\} and array\{\} will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 2
			path: src/Html/Blocks.php

		-
			message: '#^Ternary operator condition is always false\.$#'
			identifier: ternary.alwaysFalse
			count: 1
			path: src/Html/Blocks.php

		-
			message: '#^Parameter \#1 \$array \(non\-empty\-list\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Html/Timeline.php

		-
			message: '#^Strict comparison using \!\=\= between non\-empty\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Platform/HelpText.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: src/Platform/InstallLayout.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: src/Platform/InstallLayout.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: src/Platform/InstallLayout.php

		-
			message: '#^Strict comparison using \!\=\= between non\-falsy\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Platform/InstallLayout.php

		-
			message: '#^Ternary operator condition is always false\.$#'
			identifier: ternary.alwaysFalse
			count: 1
			path: src/Platform/InstallLayout.php

		-
			message: '#^Variable \$file in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.variable
			count: 1
			path: src/Platform/InstallLayout.php

		-
			message: '#^Cannot unset offset ''operator_notice'' on array\<mixed, mixed\>\.$#'
			identifier: unset.offset
			count: 1
			path: src/Platform/OperatorScreen.php

		-
			message: '#^Offset ''operator_notice'' on array\<mixed, mixed\> on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Platform/OperatorScreen.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Platform/PlatformDb.php

		-
			message: '#^Offset ''dir'' on array\{name\: string, passwd\: string, uid\: int, gid\: int, gecos\: string, dir\: string, shell\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Platform/PlatformDb.php

		-
			message: '#^Strict comparison using \!\=\= between non\-empty\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Platform/PlatformDb.php

		-
			message: '#^Offset ''name'' on array\{name\: string, passwd\: string, uid\: int, gid\: int, gecos\: string, dir\: string, shell\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Platform/Runtime.php

		-
			message: '#^Method Adlexone\\Platform\\SaasInstallScreen\:\:takeStores\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Platform/SaasInstallScreen.php

		-
			message: '#^Method Adlexone\\Platform\\SetupScreen\:\:takeStorage\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Platform/SetupScreen.php

		-
			message: '#^Offset ''label'' does not exist on array\{id\: int, name\: string, type\: string\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Screen/ApplicationSettingsScreen.php

		-
			message: '#^Parameter \#1 \$fields of static method Adlexone\\Application\\RecordQuery\:\:field\(\) expects list\<array\{id\: int, name\: string, plain\: string, label\: string, type\: string, values\: list\<string\>\}\>, list\<array\{id\: int, type\: string\}\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Screen/ApplicationsScreen.php

		-
			message: '#^Default value of the parameter \#2 \$values \(string\) of method Adlexone\\Screen\\FieldsScreen\:\:showCustomField\(\) is incompatible with type array\.$#'
			identifier: parameter.defaultValue
			count: 1
			path: src/Screen/FieldsScreen.php

		-
			message: '#^Offset ''label'' does not exist on array\{item_id\: int, title\: string, app\: string, accent\: string, href\: string, when\: int\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Screen/HomeDashboard.php

		-
			message: '#^PHPDoc tag @return has invalid value \(\)\: Unexpected token "\\n     ", expected type at offset 326 on line 8$#'
			identifier: phpDoc.parseError
			count: 1
			path: src/Screen/ItemTypesScreen.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$item$#'
			identifier: parameter.notFound
			count: 1
			path: src/Screen/RecordCensus.php

		-
			message: '#^Parameter \#1 \$field of static method Adlexone\\Screen\\RecordCensus\:\:workHref\(\) expects array\{id\: int, label\: string, type\: string, values\: list\<string\>, plain\: string\}, array\{label\: string, plain\: string\} given\.$#'
			identifier: argument.type
			count: 1
			path: src/Screen/RecordCensus.php

		-
			message: '#^Strict comparison using \!\=\= between non\-empty\-list\<mixed\> and array\{\} will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Screen/RecordCensus.php

		-
			message: '#^Comparison operation "\>" between 0 and 0 is always false\.$#'
			identifier: greater.alwaysFalse
			count: 1
			path: src/Screen/RecordPeople.php

		-
			message: '#^Offset ''0'' on array\<string, non\-empty\-list\> in isset\(\) does not exist\.$#'
			identifier: isset.offset
			count: 1
			path: src/Screen/RecordPeople.php

		-
			message: '#^Offset ''No owner'' on array\{\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Screen/RecordPeople.php

		-
			message: '#^Method Adlexone\\Screen\\RecordRegister\:\:intakeFields\(\) should return list\<array\{id\: int, plain\: string, type\: string, label\: string, values\: list\<string\>\}\> but returns list\<array\{id\: int, plain\: string, type\: ''checkBox''\|''date''\|''datetime''\|''email''\|''menu''\|''number''\|''textArea''\|''textBox'', label\: string\}\>\.$#'
			identifier: return.type
			count: 1
			path: src/Screen/RecordRegister.php

		-
			message: '#^Method Adlexone\\Screen\\RecordRegister\:\:intakeFields\(\) should return list\<array\{id\: int, plain\: string, type\: string, label\: string, values\: list\<string\>\}\> but returns list\<array\{id\: int\}\>\.$#'
			identifier: return.type
			count: 1
			path: src/Screen/RecordRegister.php

		-
			message: '#^Method Adlexone\\Screen\\RecordRegister\:\:listedFields\(\) should return list\<array\{id\: int, name\: string, plain\: string, label\: string, type\: string, values\: list\<string\>\}\> but returns list\<array\{id\: int, plain\: string, type\: string, label\: string\}\>\.$#'
			identifier: return.type
			count: 2
			path: src/Screen/RecordRegister.php

		-
			message: '#^Default value of the parameter \#1 \$userID \(string\) of method Adlexone\\Screen\\SecurityScreen\:\:showGroupMembership\(\) is incompatible with type int\.$#'
			identifier: parameter.defaultValue
			count: 1
			path: src/Screen/SecurityScreen.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$checked$#'
			identifier: parameter.notFound
			count: 1
			path: src/Screen/SecurityScreen.php

		-
			message: '#^Parameter \#2 \$values of static method Adlexone\\Screen\\SecurityScreen\:\:showGroup\(\) expects string, array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 2
			path: src/Screen/SecurityScreen.php

		-
			message: '#^Parameter \#2 \$values of static method Adlexone\\Screen\\SecurityScreen\:\:showUser\(\) expects array, string given\.$#'
			identifier: argument.type
			count: 3
			path: src/Screen/SecurityScreen.php

		-
			message: '#^Parameter \#3 \$fields of static method Adlexone\\Html\\Form\:\:form\(\) expects array\<string, string\>, array\<int\|string, string\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Screen/SecurityScreen.php

		-
			message: '#^Offset ''sortName''\|''sortOpened''\|''sortStand'' on array\{name\: string, href\: string, meta\: string, cells\: array\{type\: string, opened\: string, stand\: string\}, actions\: array, mark\: string, itemId\: int, sortName\: string, \.\.\.\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 2
			path: src/Screen/WorkList.php
